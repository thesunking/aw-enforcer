import { Button } from "std-widgets.slint";

export component ActivityHistogram inherits VerticalLayout {
    in property <string> title: "24-Hour Screen Time Activity";
    in property <string> status-level: "Loading...";
    in property <int> total-active-minutes: 0;
    in property <int> target-minutes: 480;
    in property <[float]> histogram-values;
    in property <[string]> histogram-labels;
    in property <bool> is-loading: false;
    in property <color> accent-color: #38bdf8;
    in property <color> text-color: #f8fafc;
    in property <bool> show-close-button: false;

    callback close-clicked();

    property <color> status-color: root.is-loading ? #38bdf8 :
        (root.status-level == "Great" ? #10b981 :
        (root.status-level == "Okay" ? #f59e0b : #ef4444));

    spacing: 12px;
    alignment: space-between;

    // Header & Evaluation Badge
    HorizontalLayout {
        alignment: space-between;
        spacing: 12px;
        height: 28px;

        Text {
            text: "📊 " + (root.title != "" ? root.title : "24-Hour Screen Time Activity");
            font-size: 15px;
            font-weight: 700;
            color: root.text-color;
            vertical-alignment: center;
        }

        // Status Badge
        VerticalLayout {
            alignment: center;

            Rectangle {
                height: 24px;
                border-radius: 4px;
                background: status-color.with-alpha(0.2);
                border-width: 1px;
                border-color: status-color;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;

                    Text {
                        text: root.is-loading ? "Loading..." : root.status-level;
                        font-size: 12px;
                        font-weight: 700;
                        color: status-color;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Histogram Bars + Formatted Time Labels Container
    Rectangle {
        height: 150px;
        background: #0f172a;
        border-radius: 6px;

        if root.is-loading : VerticalLayout {
            alignment: center;
            spacing: 8px;
            Text {
                text: "⏳ Loading 24-Hour Timeline...";
                font-size: 14px;
                font-weight: 600;
                color: #38bdf8;
                horizontal-alignment: center;
            }
            Text {
                text: "Querying ActivityWatch REST API...";
                font-size: 11px;
                color: #94a3b8;
                horizontal-alignment: center;
            }
        }

        if !root.is-loading : VerticalLayout {
            padding-left: 14px;
            padding-right: 18px;
            padding-top: 10px;
            padding-bottom: 8px;
            spacing: 4px;

            // Bars Row
            HorizontalLayout {
                height: 114px;
                spacing: 3px;
                alignment: space-between;

                for val[idx] in root.histogram-values : Rectangle {
                    horizontal-stretch: 1;
                    min-width: 2px;
                    height: 114px;

                    Rectangle {
                        width: 100%;
                        height: Math.max(114px * Math.min(Math.max(val, 0.0), 1.0), 2px);
                        y: parent.height - self.height;
                        background: val > 0.8 ? #ef4444 : (val > 0.5 ? #f59e0b : root.accent-color);
                        border-radius: 2px;
                    }
                }
            }

            // Time Labels Row (formatted via config.stats.histogram_time_format)
            HorizontalLayout {
                height: 14px;
                spacing: 3px;
                alignment: space-between;

                for lbl[idx] in root.histogram-labels : Rectangle {
                    horizontal-stretch: 1;
                    min-width: 2px;

                    Rectangle {
                        width: 36px;
                        x: (parent.width - self.width) / 2;

                        Text {
                            text: lbl;
                            color: #94a3b8;
                            font-size: 8px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Bottom Summary & Close Button
    HorizontalLayout {
        alignment: space-between;
        spacing: 12px;
        height: 32px;

        Text {
            text: root.is-loading ? "Fetching activity from ActivityWatch server..." : ("Active: " + Math.floor(root.total-active-minutes / 60) + "h " + Math.mod(root.total-active-minutes, 60) + "m  /  Target: " + Math.floor(root.target-minutes / 60) + "h " + Math.mod(root.target-minutes, 60) + "m");
            color: #94a3b8;
            font-size: 11px;
            vertical-alignment: center;
        }

        if root.show-close-button : VerticalLayout {
            alignment: center;

            Button {
                height: 28px;
                text: "Close";
                clicked => {
                    root.close-clicked();
                }
            }
        }
    }
}

