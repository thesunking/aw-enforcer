import { WindowDragArea } from "overlay_widgets.slint";
import { BreakEnforcer } from "break_enforcer.slint";
import { HudToast } from "hud_toast.slint";
import { HudTimer } from "hud_timer.slint";
import { ActivityHistogram } from "activity_histogram.slint";
import { FormattedParagraph } from "formatted_text.slint";

export component OverlayWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;

    in property <string> mode: "hidden"; // "break" | "hud_toast" | "hud_timer" | "hud_status" | "hidden"
    in property <string> rule-id: "";
    in property <string> title-text: "";
    in property <[FormattedParagraph]> message-paragraphs;
    in property <string> countdown-text: "00:00";
    in property <float> progress-ratio: 1.0;
    in property <bool> allow-snooze: true;
    in property <bool> strict-mode: false;
    in property <bool> click-through: false;
    in property <bool> is-user-idle: true;
    in property <bool> show-time-remaining: false;

    // Theme & Styling properties
    in property <float> overlay-opacity: 0.90;
    in property <color> accent-color: #3b82f6;
    in property <color> backdrop-color: #0f172a;
    in property <color> text-color: #f8fafc;

    // Histogram & Status properties
    in property <string> status-level: "Great"; // "Great" | "Okay" | "Excessive"
    in property <int> total-active-minutes: 0;
    in property <int> target-minutes: 480;
    in property <[float]> histogram-values;
    in property <[string]> histogram-labels;
    in property <bool> is-loading: false;

    // Toast dropdown properties
    in property <[string]> snooze-labels: ["5 min", "10 min", "15 min"];
    in property <[int]> snooze-options: [5, 10, 15];
    in-out property <int> selected-snooze-index: 0;

    callback snooze-clicked(string /* rule_id */, int /* minutes */);
    callback skip-break-clicked(string /* rule_id */);
    callback acknowledge-toast-clicked(string /* rule_id */);
    callback close-status-clicked();
    callback drag-status-window();

    // ==========================================
    // 1. FULL-SCREEN BREAK ENFORCER OVERLAY
    // ==========================================
    if root.mode == "break" : Rectangle {
        width: 100%;
        height: 100%;
        background: root.backdrop-color.with-alpha(root.overlay-opacity);

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 520px;
                    background: #1e293b;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: root.accent-color.with-alpha(0.4);

                    VerticalLayout {
                        padding: 24px;

                        BreakEnforcer {
                            title: root.title-text;
                            message-paragraphs: root.message-paragraphs;
                            countdown-text: root.countdown-text;
                            progress-ratio: root.progress-ratio;
                            accent-color: root.accent-color;
                            text-color: root.text-color;
                            is-user-idle: root.is-user-idle;
                            click-through: root.click-through;
                            strict-mode: root.strict-mode;
                            allow-snooze: root.allow-snooze;
                            skip-break => { root.skip-break-clicked(root.rule-id); }
                            snooze-clicked(m) => { root.snooze-clicked(root.rule-id, m); }
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // 2. INTERACTIVE HUD TOAST CARD (Top-Right)
    // ==========================================
    if root.mode == "hud_toast" : Rectangle {
        width: 100%;
        height: 100%;
        background: root.backdrop-color.with-alpha(root.overlay-opacity);
        border-radius: 8px;
        border-width: 1px;
        border-color: root.accent-color.with-alpha(0.5);

        WindowDragArea {
            click-through: root.click-through;
            drag => { root.drag-status-window(); }
        }

        VerticalLayout {
            padding: 16px;

            HudToast {
                title: root.title-text;
                message-paragraphs: root.message-paragraphs;
                countdown-text: root.countdown-text;
                show-time-remaining: root.show-time-remaining;
                text-color: root.text-color;
                allow-snooze: root.allow-snooze;
                strict-mode: root.strict-mode;
                snooze-labels: root.snooze-labels;
                snooze-options: root.snooze-options;
                selected-snooze-index <=> root.selected-snooze-index;
                snooze-clicked(m) => { root.snooze-clicked(root.rule-id, m); }
                acknowledge-clicked => { root.acknowledge-toast-clicked(root.rule-id); }
            }
        }
    }

    // ==========================================
    // 3. HUD TIMER / GRACE COUNTDOWN CARD
    // ==========================================
    if root.mode == "hud_timer" : Rectangle {
        width: 100%;
        height: 100%;
        background: root.backdrop-color.with-alpha(root.overlay-opacity);
        border-radius: 8px;
        border-width: 1px;
        border-color: #f59e0b;

        WindowDragArea {
            click-through: root.click-through;
            drag => { root.drag-status-window(); }
        }

        VerticalLayout {
            padding: 16px;

            HudTimer {
                title: root.title-text;
                message-paragraphs: root.message-paragraphs;
                countdown-text: root.countdown-text;
                progress-ratio: root.progress-ratio;
                text-color: root.text-color;
                allow-snooze: root.allow-snooze;
                strict-mode: root.strict-mode;
                click-through: root.click-through;
                is-test-mode: root.rule-id == "test_preview" || root.rule-id == "test_timer";
                snooze-clicked(m) => { root.snooze-clicked(root.rule-id, m); }
                dismiss-clicked => { root.acknowledge-toast-clicked(root.rule-id); }
            }
        }
    }

    // ==========================================
    // 4. HUD STATUS / 24-HOUR HISTOGRAM CARD
    // ==========================================
    if root.mode == "hud_status" : Rectangle {
        width: 100%;
        height: 100%;
        background: root.backdrop-color.with-alpha(root.overlay-opacity);
        border-radius: 10px;
        border-width: 1px;
        border-color: root.accent-color.with-alpha(0.5);

        WindowDragArea {
            click-through: root.click-through;
            drag => { root.drag-status-window(); }
        }

        VerticalLayout {
            padding-left: 20px;
            padding-right: 24px;
            padding-top: 16px;
            padding-bottom: 16px;

            ActivityHistogram {
                title: root.title-text;
                status-level: root.status-level;
                total-active-minutes: root.total-active-minutes;
                target-minutes: root.target-minutes;
                histogram-values: root.histogram-values;
                histogram-labels: root.histogram-labels;
                is-loading: root.is-loading;
                accent-color: root.accent-color;
                text-color: root.text-color;
                show-close-button: !root.click-through;
                close-clicked => { root.close-status-clicked(); }
            }
        }
    }
}
