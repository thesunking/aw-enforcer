import { Button, ComboBox, ScrollView } from "std-widgets.slint";
import { FormattedText, FormattedParagraph } from "formatted_text.slint";
import { ActivityHistogram } from "activity_histogram.slint";

component WindowDragArea inherits TouchArea {
    in property <bool> click-through: false;
    callback drag();

    enabled: !root.click-through;
    mouse-cursor: root.click-through ? default : move;
    pointer-event(pe) => {
        if pe.kind == PointerEventKind.down && pe.button == PointerEventButton.left {
            root.drag();
        }
    }
}

component ProgressBar inherits Rectangle {
    in property <float> progress: 1.0;
    in property <color> fill-color: #3b82f6;
    in property <length> bar-height: 6px;

    height: root.bar-height;
    background: #334155;
    border-radius: root.bar-height / 2;

    Rectangle {
        x: 0;
        width: parent.width * Math.min(Math.max(root.progress, 0.0), 1.0);
        height: parent.height;
        background: root.fill-color;
        border-radius: root.bar-height / 2;
    }
}

export component OverlayWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;

    in property <string> mode: "hidden"; // "break" | "hud_toast" | "hud_timer" | "hud_status" | "hidden"
    in property <string> rule-id: "";
    in property <string> title-text: "";
    in property <[FormattedParagraph]> message-paragraphs;
    in property <string> countdown-text: "00:00";
    in property <float> progress-ratio: 1.0;
    in property <bool> allow-snooze: true;
    in property <bool> strict-mode: false;
    in property <bool> click-through: false;
    in property <bool> is-user-idle: true;
    in property <bool> show-time-remaining: false;

    // Theme & Styling properties
    in property <float> overlay-opacity: 0.90;
    in property <color> accent-color: #3b82f6;
    in property <color> backdrop-color: #0f172a;
    in property <color> text-color: #f8fafc;

    // Histogram & Status properties
    in property <string> status-level: "Great"; // "Great" | "Okay" | "Excessive"
    in property <int> total-active-minutes: 0;
    in property <int> target-minutes: 480;
    in property <[float]> histogram-values;
    in property <[string]> histogram-labels;
    in property <bool> is-loading: false;

    // Toast dropdown properties
    in property <[string]> snooze-labels: ["5 min", "10 min", "15 min"];
    in property <[int]> snooze-options: [5, 10, 15];
    in-out property <int> selected-snooze-index: 0;

    callback snooze-clicked(string /* rule_id */, int /* minutes */);
    callback skip-break-clicked(string /* rule_id */);
    callback acknowledge-toast-clicked(string /* rule_id */);
    callback close-status-clicked();
    callback drag-status-window();

    // ==========================================
    // 1. FULL-SCREEN BREAK ENFORCER OVERLAY
    // ==========================================
    if root.mode == "break" : Rectangle {
        width: 100%;
        height: 100%;
        background: root.backdrop-color.with-alpha(root.overlay-opacity);

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 520px;
                    background: #1e293b;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: root.accent-color.with-alpha(0.4);

                    VerticalLayout {
                        padding: 24px;
                        spacing: 16px;

                        // Title
                        Text {
                            text: root.title-text != "" ? root.title-text : "Break Required";
                            font-size: 22px;
                            font-weight: 700;
                            color: root.text-color;
                            horizontal-alignment: center;
                        }

                        // Formatted Message Body
                        FormattedText {
                            paragraphs: root.message-paragraphs;
                        }

                        // Big Countdown Timer
                        Rectangle {
                            height: 64px;
                            background: #0f172a;
                            border-radius: 8px;

                            Text {
                                text: root.countdown-text;
                                font-size: 36px;
                                font-weight: 800;
                                color: root.is-user-idle ? #38bdf8 : #f59e0b;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Progress Bar
                        ProgressBar {
                            progress: root.progress-ratio;
                            fill-color: root.accent-color;
                            bar-height: 6px;
                        }

                        if !root.is-user-idle : Text {
                            text: "⏸ Input detected — timer paused until you step away";
                            color: #f59e0b;
                            font-size: 13px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }

                        // Interaction controls (hidden if click-through == true)
                        if !root.click-through : HorizontalLayout {
                            spacing: 12px;
                            alignment: center;

                            if !root.strict-mode : Button {
                                text: "Skip Break";
                                clicked => {
                                    root.skip-break-clicked(root.rule-id);
                                }
                            }

                            if root.allow-snooze : Button {
                                text: "Snooze (5m)";
                                clicked => {
                                    root.snooze-clicked(root.rule-id, 5);
                                }
                            }
                        }

                        if root.click-through : Text {
                            text: "Click-through break active. Dismiss via system tray or step away from your PC.";
                            color: #94a3b8;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // 2. INTERACTIVE HUD TOAST CARD (Top-Right)
    // ==========================================
    if root.mode == "hud_toast" : Rectangle {
        width: 100%;
        height: 100%;
        background: root.backdrop-color.with-alpha(root.overlay-opacity);
        border-radius: 8px;
        border-width: 1px;
        border-color: root.accent-color.with-alpha(0.5);

        WindowDragArea {
            click-through: root.click-through;
            drag => { root.drag-status-window(); }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Header
            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: "🔔 " + (root.title-text != "" ? root.title-text : "Limit Warning");
                    font-size: 16px;
                    font-weight: 700;
                    color: root.text-color;
                    vertical-alignment: center;
                }

                if root.show-time-remaining : Text {
                    text: root.countdown-text;
                    font-size: 15px;
                    font-weight: 700;
                    color: #38bdf8;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                clip: true;
                vertical-stretch: 1;
                FormattedText {
                    width: 100%;
                    paragraphs: root.message-paragraphs;
                }
            }

            // Controls: Snooze dropdown & Acknowledge
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                height: 34px;

                if root.allow-snooze && !root.strict-mode && root.snooze-options.length > 0 : HorizontalLayout {
                    spacing: 8px;

                    ComboBox {
                        width: 110px;
                        model: root.snooze-labels;
                        current-index <=> root.selected-snooze-index;
                    }

                    Button {
                        text: "Snooze";
                        clicked => {
                            root.snooze-clicked(
                                root.rule-id,
                                root.snooze-options.length > 0
                                    ? root.snooze-options[Math.min(Math.max(root.selected-snooze-index, 0), root.snooze-options.length - 1)]
                                    : 5
                            );
                        }
                    }
                }

                Button {
                    text: "OK";
                    primary: true;
                    clicked => {
                        root.acknowledge-toast-clicked(root.rule-id);
                    }
                }
            }
        }
    }

    // ==========================================
    // 3. HUD TIMER / GRACE COUNTDOWN CARD
    // ==========================================
    if root.mode == "hud_timer" : Rectangle {
        width: 100%;
        height: 100%;
        background: root.backdrop-color.with-alpha(root.overlay-opacity);
        border-radius: 8px;
        border-width: 1px;
        border-color: #f59e0b;

        WindowDragArea {
            click-through: root.click-through;
            drag => { root.drag-status-window(); }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            // Header & Countdown
            HorizontalLayout {
                Text {
                    text: "⚠️ " + (root.title-text != "" ? root.title-text : "Quota Approaching");
                    font-size: 15px;
                    font-weight: 700;
                    color: root.text-color;
                    vertical-alignment: center;
                }

                Text {
                    text: root.countdown-text;
                    font-size: 18px;
                    font-weight: 800;
                    color: #f59e0b;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                clip: true;
                vertical-stretch: 1;
                FormattedText {
                    width: 100%;
                    paragraphs: root.message-paragraphs;
                }
            }

            // Progress Bar
            ProgressBar {
                progress: root.progress-ratio;
                fill-color: #f59e0b;
                bar-height: 5px;
            }

            // Controls: Snooze & Dismiss when non-strict and interactive
            if (root.allow-snooze || root.rule-id == "test_preview" || root.rule-id == "test_timer") && !root.strict-mode && !root.click-through : HorizontalLayout {
                spacing: 8px;
                alignment: end;
                height: 30px;

                if root.allow-snooze : Button {
                    text: "Snooze (5m)";
                    clicked => {
                        root.snooze-clicked(root.rule-id, 5);
                    }
                }

                Button {
                    text: "Dismiss";
                    clicked => {
                        root.acknowledge-toast-clicked(root.rule-id);
                    }
                }
            }
        }
    }

    // ==========================================
    // 4. HUD STATUS / 24-HOUR HISTOGRAM CARD
    // ==========================================
    if root.mode == "hud_status" : Rectangle {
        width: 100%;
        height: 100%;
        background: root.backdrop-color.with-alpha(root.overlay-opacity);
        border-radius: 10px;
        border-width: 1px;
        border-color: root.accent-color.with-alpha(0.5);

        WindowDragArea {
            click-through: root.click-through;
            drag => { root.drag-status-window(); }
        }

        VerticalLayout {
            padding-left: 20px;
            padding-right: 24px;
            padding-top: 16px;
            padding-bottom: 16px;

            ActivityHistogram {
                title: root.title-text;
                status-level: root.status-level;
                total-active-minutes: root.total-active-minutes;
                target-minutes: root.target-minutes;
                histogram-values: root.histogram-values;
                histogram-labels: root.histogram-labels;
                is-loading: root.is-loading;
                accent-color: root.accent-color;
                text-color: root.text-color;
                show-close-button: !root.click-through;
                close-clicked => { root.close-status-clicked(); }
            }
        }
    }
}