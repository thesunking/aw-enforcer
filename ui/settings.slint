import { Button, Palette, ScrollView } from "std-widgets.slint";
import { RuleView, SidebarNavItem, SubTabButton } from "settings_widgets.slint";
import { GeneralTab } from "settings_general_tab.slint";
import { RulesOverview } from "settings_rules_overview.slint";
import { RuleEditor } from "settings_rule_editor.slint";
import { LiveStatusTab } from "settings_live_status_tab.slint";
import { FormattedParagraph } from "formatted_text.slint";

export { RuleView }

export component SettingsWindow inherits Window {
    title: "AW-Enforcer Settings";
    icon: @image-url("../assets/app_icon_256.png");
    min-width: 1080px;
    min-height: 700px;
    preferred-width: 1240px;
    preferred-height: 780px;
    background: #0f172a;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Navigation Tab state: 0 = General, 1 = Rules, 2 = Live Status
    in-out property <int> active-tab: 0;

    // Rules Navigation: -1 = All Rules Overview, >= 0 = specific child rule
    in-out property <int> selected-rule-idx: -1;

    // General Settings Properties
    in-out property <int> aw-port: 5600;
    in-out property <int> poll-interval-seconds: 10;
    in-out property <bool> autostart: true;
    in-out property <string> api-key: "";
    in-out property <int> day-start-hour: 4;
    in-out property <bool> suppress-fullscreen-d3d: true;
    in-out property <bool> pause-all-rules: false;
    in-out property <bool> destroy-windows-on-hide: true;
    in-out property <string> slint-renderer: "femtovg";
    in-out property <string> slint-renderer-display: "OpenGL (renderer-femtovg)";
    in-out property <bool> strict-lock-active: false;
    in-out property <bool> strict-unlocked: false;
    in-out property <int> strict-unlock-countdown: 0;
    property <bool> ui-locked-by-strict: root.strict-lock-active && !root.strict-unlocked;
    callback request-strict-unlock();
    in-out property <float> overlay-opacity: 0.90;
    in-out property <string> accent-color-hex: "#3b82f6";
    in-out property <string> background-color-hex: "#0f172a";
    in-out property <string> text-color-hex: "#f8fafc";
    in-out property <color> accent-color-preview: #3b82f6;
    in-out property <color> background-color-preview: #0f172a;
    in-out property <color> text-color-preview: #f8fafc;
    callback color-hex-edited(string /* which */, string /* hex */);
    in-out property <int> daily-target-minutes: 480;
    in-out property <int> threshold-excessive-minutes: 600;
    in-out property <int> histogram-bin-size-minutes: 60;
    in-out property <int> histogram-bin-count: 24;
    in-out property <string> time-format-code: "%H:%M";
    in property <string> time-format-preview: "✓ Preview: 14:30";
    in property <bool> time-format-valid: true;
    in-out property <bool> has-unsaved-changes: false;

    // Unified Rules Data
    in-out property <[RuleView]> rules;

    // Active Rule Properties (bound directly with <=> to avoid one-way binding severance)
    in-out property <bool> rule-enabled: true;
    in-out property <string> rule-name: "";
    in-out property <string> rule-monitor-selection: "Executables";
    in-out property <string> rule-title-regex: "";
    in-out property <string> rule-url-regex: "";
    in property <bool> rule-regex-valid: true;
    in property <string> rule-regex-error: "";
    in-out property <string> rule-trigger: "Period";
    in-out property <int> rule-period-val: 20;
    in-out property <string> rule-period-unit: "Min";
    in-out property <int> rule-reset-afk-val: 5;
    in-out property <string> rule-reset-afk-unit: "Min";
    in-out property <int> rule-limit-val: 60;
    in-out property <string> rule-limit-unit: "Min";
    in-out property <string> rule-action: "Show Overlay";
    in-out property <string> rule-notification-method: "HUD";
    in-out property <int> rule-notification-duration-val: 10;
    in-out property <string> rule-notification-duration-unit: "Sec";
    in-out property <bool> rule-show-remaining-time: true;
    in-out property <int> rule-warn-before-val: 0;
    in-out property <string> rule-warn-before-unit: "Sec";
    in-out property <int> rule-grace-val: 0;
    in-out property <string> rule-grace-unit: "Sec";
    in-out property <int> rule-break-val: 5;
    in-out property <string> rule-break-unit: "Min";
    in-out property <bool> rule-click-through: false;
    in-out property <bool> rule-strict-mode: false;
    in property <bool> warn-before-exceeds-threshold: false;

    // Known apps for dropdown picker
    in property <[string]> known-apps;

    // Live Message Preview & Editor state
    in property <[FormattedParagraph]> preview-paragraphs;
    in-out property <int> selected-message-line: 0;
    in-out property <string> editor-message-text: "";
    in property <[int]> message-lines: [1, 2, 3];
    in property <bool> line-is-h1: false;
    in property <bool> line-is-h2: false;
    in property <bool> line-is-bold: false;
    in property <bool> line-is-italic: false;
    in property <bool> line-is-underline: false;
    in property <string> line-color: "";
    in property <int> line-size: 0;
    in-out property <string> line-color-display: "Color: Default";
    in-out property <string> line-size-display: "Size: Default";

    // Live Status metrics
    in property <bool> aw-connected: false;
    in property <string> current-session-duration-text: "0m";
    in property <string> today-screentime-text: "0h 0m";
    in property <string> current-active-app: "None";
    in property <string> status-level: "Loading...";
    in property <int> total-active-minutes: 0;
    in property <int> target-minutes: 480;
    in property <[float]> histogram-values;
    in property <[string]> histogram-labels;
    in property <bool> is-loading: false;

    // Callbacks to Rust daemon
    callback save-config();
    callback discard-changes();
    callback export-config();
    callback import-config();
    callback test-overlay(string /* mode */);
    callback preview-rule-alert();
    callback show-activity-stats();
    callback validate-time-format(string /* code */);
    callback browse-executable();
    callback refresh-known-apps();

    callback add-rule();
    callback delete-rule(int /* rule_idx */);
    callback duplicate-rule(int /* rule_idx */);
    callback move-rule(int /* from_idx */, int /* to_idx */);
    callback toggle-rule-enabled(int /* rule_idx */, bool /* enabled */);
    callback snooze-rule(int /* rule_idx */, int /* minutes */);
    callback reset-rule-session(int /* rule_idx */);

    callback add-known-app-to-rule(int /* rule_idx */, string /* app */);
    callback remove-executable-from-rule(int /* rule_idx */, int /* exe_idx */);
    callback toggle-schedule-slot(int /* rule_idx */, int /* day */, int /* hour */, bool /* state */);
    callback toggle-schedule-day(int /* rule_idx */, int /* day */);
    callback toggle-schedule-hour(int /* rule_idx */, int /* hour */);
    callback apply-schedule-preset(int /* rule_idx */, string /* preset */);
    callback select-message-line(int /* line_idx */);
    callback message-text-edited(string /* text */);
    callback apply-line-style(int /* line_idx */, string /* style */);
    callback append-placeholder(int /* line_idx */, string /* placeholder */);
    callback update-message-preview(int /* rule_idx */);
    callback select-rule(int /* rule_idx */);
    callback active-rule-edited();

    HorizontalLayout {
        // ==========================================
        // LEFT SIDEBAR NAVIGATION
        // ==========================================
        Rectangle {
            width: 230px;
            background: #1e293b;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // Logo / App Title
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: #3b82f6;

                        Text {
                            text: "⏱";
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "AW-Enforcer";
                        font-size: 18px;
                        font-weight: 800;
                        color: #f8fafc;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 1px; background: #334155; }

                // Navigation Buttons
                ScrollView {
                    VerticalLayout {
                        spacing: 4px;

                        // Tab 0: General
                        SidebarNavItem {
                            text: "⚙ General";
                            active: root.active-tab == 0;
                            clicked => { root.active-tab = 0; }
                        }

                        // Tab 1: Rules Root
                        SidebarNavItem {
                            text: "📋 Rules";
                            active: root.active-tab == 1 && root.selected-rule-idx == -1;
                            highlight-text: root.active-tab == 1;
                            clicked => {
                                root.active-tab = 1;
                                root.selected-rule-idx = -1;
                                root.select-rule(-1);
                            }
                        }

                        // Indented sub-items under "Rules"
                        for r[i] in root.rules : Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: root.active-tab == 1 && root.selected-rule-idx == i ? #3b82f6.with-alpha(0.25) : (subnav.has-hover ? #334155.with-alpha(0.6) : transparent);
                            border-width: root.active-tab == 1 && root.selected-rule-idx == i ? 1px : 0px;
                            border-color: #3b82f6.with-alpha(0.7);

                            HorizontalLayout {
                                padding-left: 24px;
                                padding-right: 8px;
                                spacing: 8px;

                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: r.enabled ? #10b981 : #64748b;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: r.name != "" ? r.name : ("Rule " + (i + 1));
                                    font-size: 12px;
                                    font-weight: root.active-tab == 1 && root.selected-rule-idx == i ? 700 : 400;
                                    color: root.active-tab == 1 && root.selected-rule-idx == i ? #93c5fd : #94a3b8;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }

                            subnav := TouchArea {
                                clicked => {
                                    root.active-tab = 1;
                                    root.select-rule(i);
                                }
                            }
                        }

                        // Tab 2: Live Status
                        SidebarNavItem {
                            text: "📊 Live Status";
                            active: root.active-tab == 2;
                            clicked => {
                                root.active-tab = 2;
                            }
                        }
                    }
                }

                // Spacer pushing Save Button to bottom
                Rectangle { height: 1px; background: #334155; }

                if root.ui-locked-by-strict : Rectangle {
                    background: #7f1d1d.with-alpha(0.4);
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #ef4444;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text {
                            text: "🔒 Strict Rule Enforcing";
                            color: #fca5a5;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Button {
                            text: root.strict-unlock-countdown > 0
                                ? ("Unlocking in " + root.strict-unlock-countdown + "s...")
                                : "Unlock Editing (15s)";
                            enabled: root.strict-unlock-countdown == 0;
                            clicked => {
                                root.request-strict-unlock();
                            }
                        }
                    }
                }

                if !root.time-format-valid || !root.rule-regex-valid : Text {
                    text: !root.time-format-valid ? "⚠ Invalid time format in General Settings" : ("⚠ " + root.rule-regex-error);
                    color: #f87171;
                    font-size: 11px;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                // Save & Apply Button
                Rectangle {
                    height: 38px;
                    background: (!root.time-format-valid || !root.rule-regex-valid || root.ui-locked-by-strict) ? #1e293b.darker(0.3) :
                                root.has-unsaved-changes ? (save_touch.pressed ? #1d4ed8 : (save_touch.has-hover ? #3b82f6 : #2563eb)) :
                                (save_touch.pressed ? #0f172a : (save_touch.has-hover ? #334155 : #1e293b));
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: (!root.time-format-valid || !root.rule-regex-valid || root.ui-locked-by-strict) ? #334155 :
                                 root.has-unsaved-changes ? #60a5fa :
                                 (save_touch.has-hover ? #64748b : #475569);
                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }

                    save_touch := TouchArea {
                        enabled: root.time-format-valid && root.rule-regex-valid && !root.ui-locked-by-strict;
                        mouse-cursor: (root.time-format-valid && root.rule-regex-valid && !root.ui-locked-by-strict) ? pointer : not-allowed;
                        clicked => {
                            if !root.ui-locked-by-strict && root.time-format-valid && root.rule-regex-valid {
                                root.save-config();
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        if root.has-unsaved-changes : Text {
                            text: "●";
                            color: #38bdf8;
                            font-size: 13px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "Save & Apply Changes";
                            font-size: 13px;
                            font-weight: root.has-unsaved-changes ? 700 : 500;
                            color: (!root.time-format-valid || !root.rule-regex-valid || root.ui-locked-by-strict) ? #64748b :
                                   root.has-unsaved-changes ? #ffffff : #cbd5e1;
                            vertical-alignment: center;
                        }
                    }
                }

                // Discard Changes Button
                Rectangle {
                    height: 36px;
                    background: root.has-unsaved-changes ?
                                (discard_touch.pressed ? #450a0a : (discard_touch.has-hover ? #7f1d1d.with-alpha(0.35) : #1e293b)) :
                                #0f172a.with-alpha(0.3);
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: root.has-unsaved-changes ?
                                 (discard_touch.has-hover ? #ef4444 : #475569) :
                                 #1e293b;
                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }

                    discard_touch := TouchArea {
                        enabled: root.has-unsaved-changes && !root.ui-locked-by-strict;
                        mouse-cursor: (root.has-unsaved-changes && !root.ui-locked-by-strict) ? pointer : not-allowed;
                        clicked => {
                            if !root.ui-locked-by-strict {
                                root.discard-changes();
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        Text {
                            text: "Discard Changes";
                            font-size: 13px;
                            font-weight: 500;
                            color: root.has-unsaved-changes ?
                                   (discard_touch.has-hover ? #fca5a5 : #cbd5e1) :
                                   #475569;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ==========================================
        // MAIN CONTENT PANE
        // ==========================================
        ScrollView {
            VerticalLayout {
                alignment: start;
                padding: 24px;

                // ------------------------------------------
                // TAB 0: GENERAL SETTINGS
                // ------------------------------------------
                if root.active-tab == 0 : GeneralTab {
                    ui-locked-by-strict: root.ui-locked-by-strict;
                    aw-port <=> root.aw-port;
                    poll-interval-seconds <=> root.poll-interval-seconds;
                    autostart <=> root.autostart;
                    api-key <=> root.api-key;
                    day-start-hour <=> root.day-start-hour;
                    suppress-fullscreen-d3d <=> root.suppress-fullscreen-d3d;
                    pause-all-rules <=> root.pause-all-rules;
                    slint-renderer <=> root.slint-renderer;
                    slint-renderer-display <=> root.slint-renderer-display;
                    destroy-windows-on-hide <=> root.destroy-windows-on-hide;
                    overlay-opacity <=> root.overlay-opacity;
                    accent-color-hex <=> root.accent-color-hex;
                    accent-color-preview: root.accent-color-preview;
                    background-color-hex <=> root.background-color-hex;
                    background-color-preview: root.background-color-preview;
                    text-color-hex <=> root.text-color-hex;
                    text-color-preview: root.text-color-preview;
                    daily-target-minutes <=> root.daily-target-minutes;
                    threshold-excessive-minutes <=> root.threshold-excessive-minutes;
                    histogram-bin-size-minutes <=> root.histogram-bin-size-minutes;
                    histogram-bin-count <=> root.histogram-bin-count;
                    time-format-code <=> root.time-format-code;
                    time-format-preview: root.time-format-preview;
                    time-format-valid: root.time-format-valid;

                    has-changes => { root.has-unsaved-changes = true; }
                    color-hex-edited(which, val) => { root.color-hex-edited(which, val); }
                    test-overlay(mode) => { root.test-overlay(mode); }
                    validate-time-format(code) => { root.validate-time-format(code); }
                    show-activity-stats => { root.show-activity-stats(); }
                    export-config => { root.export-config(); }
                    import-config => { root.import-config(); }
                }

                // ------------------------------------------
                // TAB 1: UNIFIED RULES (OVERVIEW OR CHILD TAB)
                // ------------------------------------------
                if root.active-tab == 1 : VerticalLayout {
                    spacing: 18px;

                    // Top Sub-Tab Bar
                    VerticalLayout {
                        spacing: 0px;

                        ScrollView {
                            height: 40px;

                            HorizontalLayout {
                                spacing: 4px;
                                alignment: start;

                                // Overview Tab
                                SubTabButton {
                                    text: "All Rules (Overview)";
                                    is-active: root.selected-rule-idx == -1;
                                    clicked => {
                                        root.selected-rule-idx = -1;
                                        root.select-rule(-1);
                                    }
                                }

                                // Individual Rule Tabs
                                for r[i] in root.rules : SubTabButton {
                                    text: r.name != "" ? r.name : ("Rule " + (i + 1));
                                    is-active: root.selected-rule-idx == i;
                                    show-indicator: true;
                                    indicator-color: r.enabled ? #10b981 : #64748b;
                                    clicked => {
                                        root.select-rule(i);
                                    }
                                }

                                // Add Rule Button
                                Button {
                                    text: "+ Add Rule";
                                    enabled: !root.ui-locked-by-strict;
                                    clicked => {
                                        root.add-rule();
                                    }
                                }
                            }
                        }

                        // Tab baseline border
                        Rectangle {
                            height: 1px;
                            background: #334155;
                        }
                    }

                    // 1A. ROOT RULES OVERVIEW PANE
                    if root.selected-rule-idx == -1 : RulesOverview {
                        ui-locked-by-strict: root.ui-locked-by-strict;
                        strict-lock-active: root.strict-lock-active;
                        rules: root.rules;

                        add-rule => { root.add-rule(); }
                        toggle-rule-enabled(idx, enabled) => { root.toggle-rule-enabled(idx, enabled); }
                        move-rule(from, to) => { root.move-rule(from, to); }
                        snooze-rule(idx, mins) => { root.snooze-rule(idx, mins); }
                        reset-rule-session(idx) => { root.reset-rule-session(idx); }
                        select-rule(idx) => { root.select-rule(idx); }
                        duplicate-rule(idx) => { root.duplicate-rule(idx); }
                        delete-rule(idx) => { root.delete-rule(idx); }
                        has-changes => { root.has-unsaved-changes = true; }
                    }

                    // 1B. CHILD RULE TAB
                    if root.selected-rule-idx >= 0 && root.selected-rule-idx < root.rules.length : RuleEditor {
                        ui-locked-by-strict: root.ui-locked-by-strict;
                        strict-lock-active: root.strict-lock-active;
                        selected-rule-idx: root.selected-rule-idx;
                        rules: root.rules;
                        known-apps: root.known-apps;
                        rule-enabled <=> root.rule-enabled;
                        rule-name <=> root.rule-name;
                        rule-monitor-selection <=> root.rule-monitor-selection;
                        rule-title-regex <=> root.rule-title-regex;
                        rule-url-regex <=> root.rule-url-regex;
                        rule-regex-valid: root.rule-regex-valid;
                        rule-regex-error: root.rule-regex-error;
                        rule-trigger <=> root.rule-trigger;
                        rule-period-val <=> root.rule-period-val;
                        rule-period-unit <=> root.rule-period-unit;
                        rule-reset-afk-val <=> root.rule-reset-afk-val;
                        rule-reset-afk-unit <=> root.rule-reset-afk-unit;
                        rule-limit-val <=> root.rule-limit-val;
                        rule-limit-unit <=> root.rule-limit-unit;
                        rule-action <=> root.rule-action;
                        rule-notification-method <=> root.rule-notification-method;
                        rule-notification-duration-val <=> root.rule-notification-duration-val;
                        rule-notification-duration-unit <=> root.rule-notification-duration-unit;
                        rule-show-remaining-time <=> root.rule-show-remaining-time;
                        rule-warn-before-val <=> root.rule-warn-before-val;
                        rule-warn-before-unit <=> root.rule-warn-before-unit;
                        warn-before-exceeds-threshold: root.warn-before-exceeds-threshold;
                        rule-grace-val <=> root.rule-grace-val;
                        rule-grace-unit <=> root.rule-grace-unit;
                        rule-break-val <=> root.rule-break-val;
                        rule-break-unit <=> root.rule-break-unit;
                        rule-click-through <=> root.rule-click-through;
                        rule-strict-mode <=> root.rule-strict-mode;
                        overlay-opacity: root.overlay-opacity;
                        line-is-h1: root.line-is-h1;
                        line-is-h2: root.line-is-h2;
                        line-is-bold: root.line-is-bold;
                        line-is-italic: root.line-is-italic;
                        line-is-underline: root.line-is-underline;
                        line-color-display <=> root.line-color-display;
                        line-size-display <=> root.line-size-display;
                        message-lines: root.message-lines;
                        selected-message-line <=> root.selected-message-line;
                        editor-message-text <=> root.editor-message-text;
                        preview-paragraphs: root.preview-paragraphs;

                        snooze-rule(idx, mins) => { root.snooze-rule(idx, mins); }
                        reset-rule-session(idx) => { root.reset-rule-session(idx); }
                        active-rule-edited => { root.active-rule-edited(); }
                        browse-executable => { root.browse-executable(); }
                        refresh-known-apps => { root.refresh-known-apps(); }
                        add-known-app-to-rule(idx, app) => { root.add-known-app-to-rule(idx, app); }
                        remove-executable-from-rule(idx, e_idx) => { root.remove-executable-from-rule(idx, e_idx); }
                        apply-line-style(l_idx, style) => { root.apply-line-style(l_idx, style); }
                        append-placeholder(l_idx, ph) => { root.append-placeholder(l_idx, ph); }
                        select-message-line(l_idx) => { root.select-message-line(l_idx); }
                        message-text-edited(val) => { root.message-text-edited(val); root.has-unsaved-changes = true; }
                        preview-rule-alert => { root.preview-rule-alert(); }
                        toggle-schedule-slot(idx, d, h, s) => { root.toggle-schedule-slot(idx, d, h, s); }
                        toggle-schedule-day(idx, d) => { root.toggle-schedule-day(idx, d); }
                        toggle-schedule-hour(idx, h) => { root.toggle-schedule-hour(idx, h); }
                        apply-schedule-preset(idx, p) => { root.apply-schedule-preset(idx, p); }
                    }
                }

                // ------------------------------------------
                // TAB 2: LIVE STATUS
                // ------------------------------------------
                if root.active-tab == 2 : LiveStatusTab {
                    aw-connected: root.aw-connected;
                    aw-port: root.aw-port;
                    current-session-duration-text: root.current-session-duration-text;
                    today-screentime-text: root.today-screentime-text;
                    current-active-app: root.current-active-app;
                    status-level: root.status-level;
                    total-active-minutes: root.total-active-minutes;
                    target-minutes: root.target-minutes;
                    histogram-values: root.histogram-values;
                    histogram-labels: root.histogram-labels;
                    is-loading: root.is-loading;
                    accent-color: root.accent-color-preview;
                    text-color: root.text-color-preview;
                }
            }
        }
    }
}
